# Copy to .env and fill in before running:
#   podman-compose up --build
#
# docker-compose.yml / docker-compose.prod.yml read these via ${VAR:-default}
# interpolation; podman-compose and `docker compose` both load a local .env
# file automatically.

# --- Notion integration (required — see backend/README.md) -----------------
NOTION_TOKEN=
NOTION_ROOT_PARENT_PAGE_ID=
NOTION_VERSION=2026-03-11

# --- Postgres ----------------------------------------------------------
# The app authenticates with a TLS client certificate, not a password (see
# postgres/pg_hba.conf) — run scripts/generate-dev-certs.sh once before
# `podman-compose up`. Changing POSTGRES_USER requires regenerating certs
# (the client cert's CN must match it exactly).
POSTGRES_DB=lifeos
POSTGRES_USER=lifeos
# Only bootstraps the image's initial superuser; unrelated to app auth.
POSTGRES_PASSWORD=lifeos

# --- App -----------------------------------------------------------------
APP_PORT=8080

# --- CD only (docker-compose.prod.yml) ------------------------------------
# IMAGE=ghcr.io/<owner>/lifeos-backend:latest
# CERTS_DIR=./certs   # real per-VM CA/server/client certs, provisioned out of band
